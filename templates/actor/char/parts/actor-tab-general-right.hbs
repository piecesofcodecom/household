<div class="hh-panel-container">
  <!-- Conditions -->
  <section class="hh-panel">
    <div class="hh-panel-header">
      <h2>{{localize "HOUSEHOLD.Conditions.long"}}</h2>
    </div>
    <div class="hh-panel-content">
      <div class="hh-status-list">
        <div class="hh-condition-row{{#if system.conditions.embarrassed}} active{{/if}}" data-action="customEdit"
          data-object="actor" data-path="system.conditions.embarrassed" data-value="{{system.conditions.embarrassed}}"
          data-dtype="Boolean"><i class="hh-condition-dot {{#if system.conditions.embarrassed}} embarrassed{{/if}}"></i><span>{{localize
            "HOUSEHOLD.Conditions.Embarrassed"}}</span></div>
        <div class="hh-condition-row{{#if system.conditions.frightened}} active{{/if}}" data-action="customEdit"
          data-object="actor" data-path="system.conditions.frightened" data-value="{{system.conditions.frightened}}"
          data-dtype="Boolean"><i class="hh-condition-dot {{#if system.conditions.frightened}}frightened{{/if}}"></i><span>{{localize
            "HOUSEHOLD.Conditions.Frightened"}}</span></div>
        <div class="hh-condition-row{{#if system.conditions.confused}} active{{/if}}" data-action="customEdit"
          data-object="actor" data-path="system.conditions.confused" data-value="{{system.conditions.confused}}"
          data-dtype="Boolean"><i class="hh-condition-dot {{#if system.conditions.confused}}confused{{/if}}"></i><span>{{localize
            "HOUSEHOLD.Conditions.Confused"}}</span></div>
        <div class="hh-condition-row{{#if system.conditions.hurt}} active{{/if}}" data-action="customEdit"
          data-object="actor" data-path="system.conditions.hurt" data-value="{{system.conditions.hurt}}"
          data-dtype="Boolean"><i class="hh-condition-dot {{#if system.conditions.hurt}}hurt{{/if}}"></i><span>{{localize
            "HOUSEHOLD.Conditions.Hurt"}}</span></div>
        <div class="hh-condition-row{{#if system.conditions.tired}} active{{/if}}" data-action="customEdit"
          data-object="actor" data-path="system.conditions.tired" data-value="{{system.conditions.tired}}"
          data-dtype="Boolean"><i class="hh-condition-dot {{#if system.conditions.tired}}plain{{/if}}"></i><span>{{localize
            "HOUSEHOLD.Conditions.Tired"}}</span></div>
        <div class="hh-condition-row{{#if system.conditions.sick}} active{{/if}}" data-action="customEdit"
          data-object="actor" data-path="system.conditions.sick" data-value="{{system.conditions.sick}}"
          data-dtype="Boolean"><i class="hh-condition-dot {{#if system.conditions.sick}}plain{{/if}}"></i><span>{{localize
            "HOUSEHOLD.Conditions.Sick"}}</span></div>
        <div class="hh-condition-row{{#if system.conditions.poisoned}} active{{/if}}" data-action="customEdit"
          data-object="actor" data-path="system.conditions.poisoned" data-value="{{system.conditions.poisoned}}"
          data-dtype="Boolean"><i class="hh-condition-dot {{#if system.conditions.poisoned}}plain{{/if}}"></i><span>{{localize
            "HOUSEHOLD.Conditions.Poisoned"}}</span></div>
        <div class="hh-condition-row{{#if system.conditions.broken}} active{{/if}}" data-action="customEdit"
          data-object="actor" data-path="system.conditions.broken" data-value="{{system.conditions.broken}}"
          data-dtype="Boolean"><i class="hh-condition-dot {{#if system.conditions.broken}}plain{{/if}}"></i><span>{{localize
            "HOUSEHOLD.Conditions.Broken"}}</span></div>
      </div>
    </div>
  </section>

  <!-- Aces up the sleeve -->
  <section class="hh-panel">
    <div class="hh-panel-header">
      <h2>{{localize "HOUSEHOLD.AcesSleeve.long"}}</h2>
    </div>
    <div class="hh-panel-content">
      <div class="hh-aces-hand">
        <span class="hh-aces-card heart {{#if system.aces.heart}} active{{/if}}" data-action="customEdit"
          data-object="actor" data-path="system.aces.heart" data-value="{{system.aces.heart}}"
          data-dtype="Boolean"><label
            class="fa-household-heart{{#if system.aces.heart}}-full{{/if}} no-decor"></label></span>
        <span class="hh-aces-card diamond" data-action="customEdit" data-object="actor" data-path="system.aces.diamond"
          data-value="{{system.aces.diamond}}" data-dtype="Boolean"><label
            class="fa-household-diamond{{#if system.aces.diamond}}-full{{/if}} no-decor"></label></span>
        <span class="hh-aces-card club" data-action="customEdit" data-object="actor" data-path="system.aces.club"
          data-value="{{system.aces.club}}" data-dtype="Boolean"><label
            class="fa-household-club{{#if system.aces.club}}-full{{/if}} no-decor"></label></span>
        <span class="hh-aces-card spade" data-action="customEdit" data-object="actor" data-path="system.aces.spade"
          data-value="{{system.aces.spade}}" data-dtype="Boolean"><label
            class="fa-household-spade{{#if system.aces.spade}}-full{{/if}} no-decor"></label></span>
        <span class="hh-aces-card joker{{#if system.aces.joker}} active{{/if}}" data-action="customEdit"
          data-object="actor" data-path="system.aces.joker" data-value="{{system.aces.joker}}"
          data-dtype="Boolean"><label
            class="fa-household-joker{{#if system.aces.joker}}-full{{/if}} no-decor"></label></span>
      </div>
    </div>
  </section>
</div>

