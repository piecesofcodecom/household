<!-- Decorum -->
<section class="hh-panel">
  <div class="hh-panel-header">
    <h2>{{localize "HOUSEHOLD.Decorum.long"}}</h2>
  </div>
  <div class="hh-panel-content">
    <div class="hh-decorum-scale">
      <span class="hh-decorum-step{{#when system.decorum 'eq' 1}} active{{/when}}" data-action="customEdit"
        data-object="actor" data-path="system.decorum" data-value="1" data-dtype="Number">{{localize
        "HOUSEHOLD.Decorum.Uncouth"}}</span>
      <span class="hh-decorum-step{{#when system.decorum 'eq' 2}} active{{/when}}" data-action="customEdit"
        data-object="actor" data-path="system.decorum" data-value="2" data-dtype="Number">{{localize
        "HOUSEHOLD.Decorum.Shabby"}}</span>
      <span class="hh-decorum-step{{#when system.decorum 'eq' 3}} active{{/when}}" data-action="customEdit"
        data-object="actor" data-path="system.decorum" data-value="3" data-dtype="Number">{{localize
        "HOUSEHOLD.Decorum.Decent"}}</span>
      <span class="hh-decorum-step{{#when system.decorum 'eq' 4}} active{{/when}}" data-action="customEdit"
        data-object="actor" data-path="system.decorum" data-value="4" data-dtype="Number">{{localize
        "HOUSEHOLD.Decorum.Elegant"}}</span>
      <span class="hh-decorum-step{{#when system.decorum 'eq' 5}} active{{/when}}" data-action="customEdit"
        data-object="actor" data-path="system.decorum" data-value="5" data-dtype="Number">{{localize
        "HOUSEHOLD.Decorum.Pompous"}}</span>
    </div>
  </div>
</section>

<!-- Terrible Terrible Things -->
<section class="hh-panel">
  <div class="hh-panel-header">
    <h2>{{localize "HOUSEHOLD.TTT.long"}}</h2>
  </div>
  <div class="hh-panel-content">
    <div class="flexrow" style="justify-content: center; gap: 8px;">
      {{#numLoop 5}}
      {{#when ../system.ttt 'gteq' this}}
      <input class="input-hidden" type="radio" id="ttt-{{this}}-{{../id}}" data-value="{{reduceBy this 1}}"
        data-dtype="Number" data-path="system.ttt" data-object="actor" data-action="customEdit">
      <label for="ttt-{{this}}-{{../id}}">
        <img class="custom-edit" width="28" height="28" style="border: 0;"
          src="/systems/household/assets/sheet/ttt{{this}}-filled.svg" data-value="{{reduceBy this 1}}"
          data-dtype="Number" data-path="system.ttt">
      </label>
      {{else}}
      <input class="input-hidden" type="radio" id="ttt-{{this}}-{{../id}}" data-value="{{this}}" data-dtype="Number"
        data-path="system.ttt" data-object="actor" data-action="customEdit">
      <label for="ttt-{{this}}-{{../id}}">
        <img class="custom-edit" width="28" height="28" style="border: 0;" data-value="{{this}}" data-dtype="Number"
          data-path="system.ttt" src="/systems/household/assets/sheet/ttt{{this}}.svg">
      </label>
      {{/when}}
      {{/numLoop}}
    </div>
  </div>
</section>