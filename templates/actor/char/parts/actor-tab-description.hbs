{{!-- Biography Tab --}}
<section class="tab biography description-details {{tabs.description.cssClass}}" data-tab="description"
  data-group="primary">
  <div class="hh-sheet-body">

    <section class="hh-panel">
      <div class="hh-panel-header"><h2>{{localize "HOUSEHOLD.Memories.long"}}</h2></div>
      <div class="hh-panel-content">
        <div class="hh-chapter-grid">
          <div class="hh-chapter-row">
            <label>{{localize "HOUSEHOLD.Prologue.long"}}</label>
            <input type="text" name="system.chapters.prologue" value="{{system.chapters.prologue}}" data-dtype="String" />
          </div>
          <div class="hh-chapter-row">
            <label>{{localize "HOUSEHOLD.ChapterI.long"}}</label>
            <input type="text" name="system.chapters.chapter1" value="{{system.chapters.chapter1}}" data-dtype="String" />
          </div>
          <div class="hh-chapter-row">
            <label>{{localize "HOUSEHOLD.ChapterII.long"}}</label>
            <input type="text" name="system.chapters.chapter2" value="{{system.chapters.chapter2}}" data-dtype="String" />
          </div>
          <div class="hh-chapter-row">
            <label>{{localize "HOUSEHOLD.ChapterIII.long"}}</label>
            <div class="hh-chapter-inputs">
              <input type="text" name="system.chapters.chapter3_0" value="{{system.chapters.chapter3_0}}"
                data-dtype="String" />
              <input type="text" name="system.chapters.chapter3_1" value="{{system.chapters.chapter3_1}}"
                data-dtype="String" />
            </div>
          </div>
          <div class="hh-chapter-row">
            <label>{{localize "HOUSEHOLD.ChapterIV.long"}}</label>
            <div class="hh-chapter-inputs">
              <input type="text" name="system.chapters.chapter4_0" value="{{system.chapters.chapter4_0}}"
                data-dtype="String" />
              <input type="text" name="system.chapters.chapter4_1" value="{{system.chapters.chapter4_1}}"
                data-dtype="String" />
            </div>
          </div>
          <div class="hh-chapter-row">
            <label>{{localize "HOUSEHOLD.ChapterV.long"}}</label>
            <div class="hh-chapter-inputs">
              <input type="text" name="system.chapters.chapter5_0" value="{{system.chapters.chapter5_0}}"
                data-dtype="String" />
              <input type="text" name="system.chapters.chapter5_1" value="{{system.chapters.chapter5_1}}"
                data-dtype="String" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="hh-panel">
      <div class="hh-panel-header"><h2>{{localize "HOUSEHOLD.Experience.long"}}</h2></div>
      <div class="hh-panel-content">
        <div class="hh-bio-editor text-editor">
          {{#if editable}}
          <prose-mirror name="system.biography" button="true" editable="{{editable}}" toggled="false"
            value="{{system.biography}}">
            {{{descriptionHTML}}}
          </prose-mirror>
          {{else}}
          {{{descriptionHTML}}}
          {{/if}}
        </div>
      </div>
    </section>

  </div>
</section>
