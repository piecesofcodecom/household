{{#each items as |item id|}}
{{!-- `item-list` class + data-item-id are required by the attack-roll handler
(target.closest('.item-list').dataset.itemId). --}}
<details class="item-list hh-item-entry" data-item-id="{{item._id}}" data-object="item"
  data-character-id="{{@root.id}}">
  <summary class="hh-item-row">
    <a class="hh-item-icon" data-action="show" data-sub-action="show" title="Show Item">
      <img src="{{item.img}}" alt="{{item.name}}" />
    </a>
    <div class="hh-item-main">
      <strong title="{{item.name}}">{{item.name}} {{#when type 'eq' 'trait'}} {{#if item.system.optional}} ({{localize
        "HOUSEHOLD.Optional.long" type=" Item"}}) {{/if}} {{/when}} </strong>
      <small>
        {{#if item.system.field}}
        <i style="color: {{getFieldColor item.system.field}}"
          class="fa-household-{{getSuitFromField item.system.field}}-full"></i>
        {{/if}}
        {{#each item.system.suits as |value key|}}
        {{#if value}}
        <i style="color: {{getFieldColor key}}" class="fa-household-{{getSuitFromField key}}-full"></i>
        {{/if}}
        {{/each}}
        {{#if item.system.type}}<i class="fa-regular {{getWeaponTypeIcon item.system.type}}"></i>{{/if}}
        {{#if item.system.price}}<span>{{item.system.price}} <i style="color: #d49d08"
            class="fa-solid fa-coins"></i></span>{{/if}}
      </small>
    </div>
    <div class="hh-item-actions">
      {{#if item.system.type}}
      {{#when type 'noteq' 'contract'}}
      <a class="hh-item-act" data-action="roll" data-type="attack" title="Roll attack"><i
          class="fa-regular fa-dice"></i></a>
      {{/when}}
      {{/if}}
      {{#when type 'eq' 'move'}}
      <a class="hh-item-act" data-action="roll" data-type="item" title="Use Item">
        <i class="fa-regular fa-dice"></i>
      </a>

      <a class="hh-item-act" data-object="item" data-action="customEdit" data-id="{{item._id}}"
        data-value="{{item.system.exhausted}}" data-dtype="Boolean" data-item-id="{{item._id}}"
        data-character-id="{{@root.id}}" title="Toggle exhausted">
        {{#if item.system.exhausted}}<i style="color: red" class="fa-regular fa-toggle-large-off"></i>{{else}}<i
          style="color: green" class="fa-regular fa-toggle-large-on"></i>{{/if}}
      </a>
      {{/when}}
      <a class="hh-item-act" data-action="itemEdit" data-item-id="{{item._id}}"
        title='{{localize "DOCUMENT.Update" type=" Item"}}'><i class="fas fa-edit"></i></a>
      <a class="hh-item-act" data-action="itemDelete" data-item-id="{{item._id}}"
        title='{{localize "DOCUMENT.Delete" type=" Item"}}'><i class="fas fa-trash"></i></a>
    </div>
  </summary>

  <div class="hh-item-body">
    {{#if item.system.requirements}}<b>{{item.system.requirements}}</b><br />{{/if}}
    {{#if item.system.trait}}<b>{{item.system.trait}}</b><br />{{/if}}
    {{#when type 'eq' 'contract'}}
    <div class="hh-two-col">
      <div>
        <h4>{{localize "HOUSEHOLD.Concession.long"}}: {{item.system.concession.name}}</h4>
        <div>{{{item.system.concession.details}}}</div>
      </div>
      <div>
        <h4>{{localize "HOUSEHOLD.Counterpart.long"}}: {{item.system.counterpart.name}}</h4>
        <div>{{{item.system.counterpart.details}}}</div>
      </div>
    </div>
    {{else}}
    {{{item.system.description}}}
    {{/when}}
  </div>
</details>
{{/each}}