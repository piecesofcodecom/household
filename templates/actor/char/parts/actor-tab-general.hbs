<section class="tab features general-details {{tabs.general.cssClass}}" data-tab="general" data-group="primary">
  <div class="hh-character-grid">

    <section class="hh-panel hh-fields-panel{{#if sheetLocked}} sheet-locked{{/if}}">
      <div class="hh-panel-header">
        <h2>Fields &amp; Skills</h2>
        <button type="button" class="hh-lock-button {{#if sheetLocked}}locked{{else}}unlocked{{/if}}"
          data-action="toggleLock" title="Toggle sheet lock">
          <span class="hh-lock-mark"></span>
          <span>{{#if sheetLocked}}Locked{{else}}Unlocked{{/if}}</span>
        </button>
      </div>
      <div class="hh-panel-content-fields">
        {{#each system.fields as |ability key|}}
        <article class="hh-field-card">
          <div class="hh-field-card-title">
            <h3>{{ability.label}}</h3>
            <span class="hh-field-rank">
              {{#numLoop 2}}
              <input id="{{key}}-{{this}}-{{@root.id}}"
                class="fa-household-{{ability.suit}}{{#when ability.value 'gteq' this}}-full{{/when}} no-decor"
                type="radio" name="system.fields.{{key}}.value" value="{{this}}" data-dtype="Number"
                {{doCheckIf ability.value 'eq' this}} {{#if @root.sheetLocked}}disabled{{/if}} />
              {{/numLoop}}
            </span>
          </div>
          {{#each @root.system.skills as |skill ky|}}
          {{#when skill.field 'eq' key}}
          <div class="hh-skill-row">
            <label class="rollable" data-action="roll" data-type="skill" data-field="{{key}}" data-key="{{ky}}"
              data-label="{{skill.label}}">{{skill.label}}</label>
            <span class="hh-skill-suits">
              {{#numLoop 4}}
              <input id="{{ky}}-{{this}}-{{@root.id}}"
                class="fa-household-{{ability.suit}}{{#when skill.value 'gteq' this}}-full{{/when}} no-decor"
                type="radio" name="system.skills.{{ky}}.value" value="{{this}}" data-dtype="Number"
                {{doCheckIf skill.value 'eq' this}} {{#if @root.sheetLocked}}disabled{{/if}} />
              {{/numLoop}}
            </span>
          </div>
          {{/when}}
          {{/each}}
        </article>
        {{/each}}
      </div>
    </section>

    <div class="hh-character-right">
      {{> "systems/household/templates/actor/char/parts/actor-tab-general-right.hbs"}}
    </div>

  </div>
</section>
