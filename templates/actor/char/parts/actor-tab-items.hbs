{{!-- Owned Items Tab --}}
<section class="tab items {{tabs.items.cssClass}}" data-tab="items" data-group="primary">
  
    <div class="hh-character-tab-main">

      <section class="hh-panel">
        <div class="hh-panel-header"><h2>{{localize "HOUSEHOLD.Wealth.long"}}</h2></div>
        <div class="hh-panel-content">
          <div class="hh-two-col">
            <div class="hh-field-control">
              <label>{{localize "HOUSEHOLD.Wealth.long"}}</label>
              <input type="text" name="system.wealth" value="{{system.wealth}}" data-dtype="String" />
            </div>
            <div class="hh-field-control">
              <label>{{localize "HOUSEHOLD.Coins.long"}}</label>
              <input type="text" name="system.coins" value="{{system.coins}}" data-dtype="String" />
            </div>
          </div>
        </div>
      </section>

      <section class="hh-panel">
        <div class="hh-panel-header">
          <h2>{{localize "HOUSEHOLD.SheetLabels.General"}}</h2>
          <button type="button" class="hh-icon-button" data-action="itemCreate" data-type="item">+</button>
        </div>
        <div class="hh-panel-content">
          {{> "systems/household/templates/actor/char/parts/actor-list-items.hbs" items=gear type='equipament'}}
        </div>
      </section>

      {{!-- <section class="hh-panel">
        <div class="hh-panel-header">
