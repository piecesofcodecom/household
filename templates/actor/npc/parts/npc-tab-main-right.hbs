<section class="tab {{tabs.main.cssClass}}" data-tab="main" data-group="primary">

  <section class="hh-panel">
    <div class="hh-panel-header">
      <h2>{{localize "HOUSEHOLD.Stress.long"}}</h2>
      <span class="hh-tag">{{system.stress.value}} / {{system.stress.max}}</span>
    </div>
    <div class="hh-panel-content">
      <div class="hh-stress-caption">
        <span>Crucial boxes trigger encounter effects.</span>
        <span class="hh-stress-legend"><i class="hh-stress-box crucial"><span></span></i> Crucial</span>
      </div>
      <div class="hh-stress-track">
        {{#numLoop system.stress.max}}
        {{#when this 'lteq' (math @root.system.stress.max "-" @root.system.stress.value) }}
        <input id="stress-{{this}}-{{../id}}" class="input-hidden" type="radio" name="system.stress.value"
          value="{{reduceBy ../system.stress.max (math this "-" 1)}}" data-dtype="Number" />
        <label class="hh-stress-box filled{{#when this 'in' ../system.crucial_boxes}} crucial{{/when}}"
          for="stress-{{this}}-{{../id}}"><span>{{this}}</span></label>
        {{else}}
        <input id="stress-{{this}}-{{../id}}" class="input-hidden" type="radio" name="system.stress.value"
          value="{{reduceBy ../system.stress.max this}}" data-dtype="Number" />
        <label class="hh-stress-box{{#when this 'in' ../system.crucial_boxes}} crucial{{/when}}"
          for="stress-{{this}}-{{../id}}"><span>{{this}}</span></label>
        {{/when}}
        {{/numLoop}}
      </div>
    </div>
  </section>

  <section class="hh-panel">
    <div class="hh-panel-header">
      <h2>{{localize "HOUSEHOLD.Moves.long"}}</h2>
      <button type="button" class="hh-icon-button" data-action="itemCreate" data-type="move">+</button>
    </div>
    <div class="hh-panel-content">
      {{> "systems/household/templates/actor/char/parts/actor-list-items.hbs" items=moves type="move"}}
    </div>
  </section>

  <section class="hh-panel">
    <div class="hh-panel-header">
      <h2>{{localize "HOUSEHOLD.Traits.long"}}</h2>
      <button type="button" class="hh-icon-button" data-action="itemCreate" data-type="trait">+</button>
    </div>
    <div class="hh-panel-content">
      {{> "systems/household/templates/actor/char/parts/actor-list-items.hbs" items=traits type="trait"}}
    </div>
  </section>

</section>
