<section class="tab {{tabs.biography.cssClass}}" data-tab="biography" data-group="primary">
  <section class="hh-panel">
    <div class="hh-panel-header"><h2>{{localize "HOUSEHOLD.SheetLabels.Description"}}</h2></div>
    <div class="hh-panel-content">
      <div class="hh-editor text-editor">
        {{#if editable}}
        <prose-mirror name="system.biography" button="true" editable="{{editable}}" toggled="false"
          value="{{system.biography}}">
          {{{descriptionHTML}}}
        </prose-mirror>
        {{else}}
        {{{descriptionHTML}}}
        {{/if}}
      </div>
    </div>
  </section>
</section>
