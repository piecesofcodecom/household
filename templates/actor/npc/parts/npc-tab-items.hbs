<section class="tab {{tabs.items.cssClass}}" data-tab="items" data-group="primary">
  <section class="hh-panel">
    <div class="hh-panel-header">
      <h2>{{localize "HOUSEHOLD.SheetLabels.General"}}</h2>
      <button type="button" class="hh-icon-button" data-action="itemCreate" data-type="item">+</button>
    </div>
    <div class="hh-panel-content">
      {{> "systems/household/templates/actor/char/parts/actor-list-items.hbs" items=gear type='item'}}
    </div>
  </section>

  <section class="hh-panel">
    <div class="hh-panel-header">
      <h2>{{localize "HOUSEHOLD.Weapons.long"}}</h2>
      <button type="button" class="hh-icon-button" data-action="itemCreate" data-type="weapon">+</button>
    </div>
    <div class="hh-panel-content">
      {{> "systems/household/templates/actor/char/parts/actor-list-items.hbs" items=weapons type='weapon'}}
    </div>
  </section>

  <section class="hh-panel">
    <div class="hh-panel-header">
      <h2>{{localize "HOUSEHOLD.Gadgets.long"}}</h2>
      <button type="button" class="hh-icon-button" data-action="itemCreate" data-type="gadget">+</button>
    </div>
    <div class="hh-panel-content">
      {{> "systems/household/templates/actor/char/parts/actor-list-items.hbs" items=gadgets type='gadget'}}
    </div>
  </section>
</section>
