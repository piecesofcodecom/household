<div class="hud-dock">

  {{!-- ===================== Actions pop-over (the six numbered actions) ===================== --}}
  <div class="character-actions hud-popover {{#when characterActions 'noteq' ''}}{{tabs.characterActions}}{{/when}}">
    <div class="npc-actions-content hud-popover-card hud-popover-scroll">
      <div class="hud-popover-head"><h2>{{localize "HOUSEHOLD.actions"}}</h2></div>
      <div class="hud-action-list">
        <div class="hud-action-row"><span class="roman">I</span><p>{{actions.action_1}}</p></div>
        <div class="hud-action-row"><span class="roman">II</span><p>{{actions.action_2}}</p></div>
        <div class="hud-action-row"><span class="roman">III</span><p>{{actions.action_3}}</p></div>
        <div class="hud-action-row"><span class="roman">IV</span><p>{{actions.action_4}}</p></div>
        <div class="hud-action-row"><span class="roman">V</span><p>{{actions.action_5}}</p></div>
        <div class="hud-action-row"><span class="roman">VI</span><p>{{actions.action_6}}</p></div>
      </div>
    </div>
  </div>

  {{!-- ===================== Status pop-over (stress + moves/traits) ===================== --}}
  <div class="character-skills hud-popover {{#when characterStats 'noteq' ''}}{{tabs.characterStats}}{{/when}}">
    <div class="npc-skills-content hud-popover-card hud-popover-scroll">
      {{!-- <div class="hud-popover-head"><h2>{{localize "HOUSEHOLD.Stress.long"}}</h2></div>
      <div class="hud-stress-track">
        {{#numLoop stress.max}}
        <i
          class="hud-sbox{{#when this 'in' @root/crucial_boxes}} crucial{{/when}}{{#when this 'lteq' @root/stress.value}} filled{{/when}}">{{this}}</i>
        {{/numLoop}}
      </div> --}}
      {{#each items as |items kind|}}
      {{#ifNotEmpty items}}
      <div class="hud-popover-head"><h2>{{localize (concat "HOUSEHOLD." kind ".long")}}</h2></div>
      <div class="hud-item-list">
        {{> "systems/household/templates/actor/hud/actor-hud-list-items.hbs" items=items type="{{kind}}" }}
      </div>
      {{/ifNotEmpty}}
      {{/each}}
    </div>
  </div>

  {{!-- ===================== Always-visible bar ===================== --}}
  <div class="character-info hud-bar">
    <div class="hud-portrait opponent" data-tooltip="{{name}}">
      <div id="frame" class="npc-frame"></div>
      <div id="photo-mask">
        <img src="{{picture}}" alt="{{name}}" class="photo-subject">
      </div>
      <div id="glass-highlight"></div>
      <div id="grunge-texture-npc" style="opacity: {{stressPercentage stress}};"></div>
      <span class="sheet-open hud-open" data-character-id="{{id}}">{{localize "HOUSEHOLD.open_sheet"}}</span>
    </div>

    <div class="hud-identity">
      <span class="hud-name">{{name}}</span>
      <span class="hud-threat"
        data-tooltip="{{#when threat.level 'lteq' 1}}{{localize 'HOUSEHOLD.BasicOpponent.long'}}{{else}}{{localize 'HOUSEHOLD.CriticalOpponent.long'}}{{/when}}">
        {{#numLoop 5}}
        <i class="threat-pip fa-solid fa-spider{{#when @root/threat.level 'gteq' this}} filled{{/when}}"></i>
        {{/numLoop}}
      </span>
      <span class="hud-stress">
        <a class="hud-step editValue" data-path="system.stress.value" data-value="{{reduceBy stress.value 1}}"
          data-character-id="{{@root/id}}" data-dtype="Number" title="{{localize 'MESSAGES.Stress.Reduce'}}">&minus;</a>
        <span class="hud-stress-read{{#if stressCrucial}} crucial{{/if}}"
          {{#if stressCrucial}}data-tooltip="{{localize 'HOUSEHOLD.Stress.long'}}"{{/if}}>{{#if stressCrucial}}<i
            class="fa-solid fa-triangle-exclamation"></i> {{/if}}<b>{{stress.value}}</b><span>/ {{stress.max}} {{localize
            "HOUSEHOLD.Stress.long"}}</span></span>
        <a class="hud-step editValue" data-path="system.stress.value" data-value="{{increaseBy stress.value 1}}"
          data-character-id="{{@root/id}}" data-dtype="Number" title="{{localize 'MESSAGES.Stress.Increase'}}">+</a>
      </span>
    </div>

    <button class="hud-roll roll-action" data-character-id="{{id}}" data-tooltip="{{localize 'MESSAGES.Actionroll'}}">
      <i class="fa-solid fa-dice"></i> {{localize "HOUSEHOLD.actions"}}
    </button>

    <div class="hud-toolbar hud-toolbar-2">
      <button class="hud-chip hud-chip-wide actions-toggle{{#when actionsToggle 'noteq' ''}}{{tabs.actionsToggle}}{{/when}}">{{localize
        "HOUSEHOLD.actions"}}</button>
      <button class="hud-chip hud-chip-wide skills-toggle{{#when statsToggle 'noteq' ''}}{{tabs.statsToggle}}{{/when}}">{{localize
        "HOUSEHOLD.stats"}}</button>
    </div>
  </div>
</div>
