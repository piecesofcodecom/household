<div class="hud-dock">

  {{!-- ============ Skills pop-over (all four fields side by side) ============ --}}
  <div class="character-skills hud-popover {{#when characterSkills 'noteq' ''}}{{tabs.characterSkills}}{{/when}}">
    <section class="character-skills-content-society hud-skill-field hud-popover-card">
      <div class="hud-popover-head">
        <h2><i class="fa-household-heart-full"></i> {{localize
          "HOUSEHOLD.Field.Society.long"}}</h2>
      </div>
      <ul class="hud-skill-list">
        {{#each skills as |skill|}}{{#when skill.field 'eq' 'society'}}
        <li class="hud-skill-row skill rollable" data-type="skill" data-field="{{skill.field}}" data-key="{{skill.id}}"
          data-label="{{skill.name}}" data-character-id="{{@root/id}}">
          <span class="hud-skill-name">{{skill.name}}</span>
          <span class="hud-skill-rank">{{skill.mod}}<i class="fa-household-{{skill.suit}}-full"></i></span>
        </li>
        {{/when}}{{/each}}
      </ul>
    </section>
    <section class="character-skills-content-academia hud-skill-field hud-popover-card">
      <div class="hud-popover-head">
        <h2><i class="fa-household-diamond-full"></i> {{localize
          "HOUSEHOLD.Field.Academia.long"}}</h2>
      </div>
      <ul class="hud-skill-list">
        {{#each skills as |skill|}}{{#when skill.field 'eq' 'academia'}}
        <li class="hud-skill-row skill rollable" data-type="skill" data-field="{{skill.field}}" data-key="{{skill.id}}"
          data-label="{{skill.name}}" data-character-id="{{@root/id}}">
          <span class="hud-skill-name">{{skill.name}}</span>
          <span class="hud-skill-rank">{{skill.mod}}<i class="fa-household-{{skill.suit}}-full"></i></span>
        </li>
        {{/when}}{{/each}}
      </ul>
    </section>
    <section class="character-skills-content-war hud-skill-field hud-popover-card">
      <div class="hud-popover-head">
        <h2><i class="fa-household-club-full"></i> {{localize
          "HOUSEHOLD.Field.War.long"}}</h2>
      </div>
      <ul class="hud-skill-list">
        {{#each skills as |skill|}}{{#when skill.field 'eq' 'war'}}
        <li class="hud-skill-row skill rollable" data-type="skill" data-field="{{skill.field}}" data-key="{{skill.id}}"
          data-label="{{skill.name}}" data-character-id="{{@root/id}}">
          <span class="hud-skill-name">{{skill.name}}</span>
          <span class="hud-skill-rank">{{skill.mod}}<i class="fa-household-{{skill.suit}}-full"></i></span>
        </li>
        {{/when}}{{/each}}
      </ul>
    </section>
    <section class="character-skills-content-street hud-skill-field hud-popover-card">
      <div class="hud-popover-head">
        <h2><i class="fa-household-spade-full"></i> {{localize
          "HOUSEHOLD.Field.Street.long"}}</h2>
      </div>
      <ul class="hud-skill-list">
        {{#each skills as |skill|}}{{#when skill.field 'eq' 'street'}}
        <li class="hud-skill-row skill rollable" data-type="skill" data-field="{{skill.field}}" data-key="{{skill.id}}"
          data-label="{{skill.name}}" data-character-id="{{@root/id}}">
          <span class="hud-skill-name">{{skill.name}}</span>
          <span class="hud-skill-rank">{{skill.mod}}<i class="fa-household-{{skill.suit}}-full"></i></span>
        </li>
        {{/when}}{{/each}}
      </ul>
    </section>
  </div>

  {{!-- ============ Actions + Stats pop-over (side by side) ============ --}}
  <div class="character-actions hud-popover {{#when characterActions 'noteq' ''}}{{tabs.characterActions}}{{/when}}">
    <div class="hud-combo">
      <div class="character-actions-content hud-popover-scroll">
        {{#each items as |items kind|}}
        {{#ifNotEmpty items}}
        <section class="hud-popover-card">
          <div class="hud-popover-head">
            <h2>{{localize (concat "HOUSEHOLD." kind ".long")}}</h2>
          </div>
          <div class="hud-item-list">
            {{> "systems/household/templates/actor/hud/actor-hud-list-items.hbs" items=items type="{{kind}}" }}
          </div>
        </section>
        {{/ifNotEmpty}}
        {{/each}}
      </div>

      <div class="character-stats-content hud-popover-scroll">
        <section class="hud-popover-card">
          <div class="hud-popover-head">
            <h2>{{localize "HOUSEHOLD.Conditions.long"}}</h2>
          </div>
          <div class="hud-conditions">
            <div class="hud-condition condition editValue rollable" data-character-id="{{@root/id}}"
              data-dtype="Boolean" data-path="system.conditions.embarrassed">
              <i class="hud-cond-dot fa-household-heart{{#if conditions.embarrassed}}-full{{/if}}"></i>
              <span>{{localize "HOUSEHOLD.Conditions.Embarrassed"}}</span>
            </div>
            <div class="hud-condition condition editValue rollable" data-character-id="{{@root/id}}"
              data-dtype="Boolean" data-path="system.conditions.confused">
              <i class="hud-cond-dot fa-household-diamond{{#if conditions.confused}}-full{{/if}}"></i>
              <span>{{localize "HOUSEHOLD.Conditions.Confused"}}</span>
            </div>
            <div class="hud-condition condition editValue rollable" data-character-id="{{@root/id}}"
              data-dtype="Boolean" data-path="system.conditions.hurt">
              <i class="hud-cond-dot fa-household-club{{#if conditions.hurt}}-full{{/if}}"></i>
              <span>{{localize "HOUSEHOLD.Conditions.Hurt"}}</span>
            </div>
            <div class="hud-condition condition editValue rollable" data-character-id="{{@root/id}}"
              data-dtype="Boolean" data-path="system.conditions.frightened">
              <i class="hud-cond-dot fa-household-spade{{#if conditions.frightened}}-full{{/if}}"></i>
              <span>{{localize "HOUSEHOLD.Conditions.Frightened"}}</span>
            </div>
            <div class="hud-condition condition editValue rollable" data-character-id="{{@root/id}}"
              data-dtype="Boolean" data-path="system.conditions.tired">
              <i class="hud-cond-dot fa-{{#if conditions.tired}}solid{{else}}light{{/if}} fa-circle"></i>
              <span>{{localize "HOUSEHOLD.Conditions.Tired"}}</span>
            </div>
            <div class="hud-condition condition editValue rollable" data-character-id="{{@root/id}}"
              data-dtype="Boolean" data-path="system.conditions.sick">
              <i class="hud-cond-dot fa-{{#if conditions.sick}}solid{{else}}light{{/if}} fa-circle"></i>
              <span>{{localize "HOUSEHOLD.Conditions.Sick"}}</span>
            </div>
            <div class="hud-condition condition editValue rollable" data-character-id="{{@root/id}}"
              data-dtype="Boolean" data-path="system.conditions.poisoned">
              <i class="hud-cond-dot fa-{{#if conditions.poisoned}}solid{{else}}light{{/if}} fa-circle"></i>
              <span>{{localize "HOUSEHOLD.Conditions.Poisoned"}}</span>
            </div>
            <div class="hud-condition condition editValue rollable" data-character-id="{{@root/id}}"
              data-dtype="Boolean" data-path="system.conditions.broken">
              <i class="hud-cond-dot fa-{{#if conditions.broken}}solid{{else}}light{{/if}} fa-circle"></i>
              <span>{{localize "HOUSEHOLD.Conditions.Broken"}}</span>
            </div>
          </div>
        </section>

        <section class="hud-popover-card">
          <div class="hud-popover-head">
            <h2>{{localize "HOUSEHOLD.Decorum.long"}}</h2>
          </div>
          <div class="hud-decorum">
            <span title="{{localize 'HOUSEHOLD.Decorum.Uncouth'}}" class="editValue hh-decorum-step {{#when decorum 'eq' 1}} active{{/when}}" data-action="customEdit"
              data-object="actor" data-character-id="{{@root/id}}" data-path="system.decorum" data-value="1"
              data-dtype="Number" style="min-width: 38px;"></span>
            {{!-- <a class="editValue hud-decorum-step{{#when decorum 'eq' 1}} active{{/when}}"
              data-character-id="{{@root/id}}" data-path="system.decorum" data-value="1" data-dtype="Number"
              title="{{localize 'HOUSEHOLD.Decorum.Uncouth'}}"></a> --}}
            <span title="{{localize 'HOUSEHOLD.Decorum.Shabby'}}" class="editValue hh-decorum-step {{#when decorum 'eq' 2}} active{{/when}}" data-action="customEdit"
              data-object="actor" data-character-id="{{@root/id}}" data-path="system.decorum" data-value="2"
              data-dtype="Number" style="min-width: 38px;"></span>

            {{!-- <a class="editValue hud-decorum-step{{#when decorum 'eq' 2}} active{{/when}}"
              data-character-id="{{@root/id}}" data-path="system.decorum" data-value="2" data-dtype="Number"
              title="{{localize 'HOUSEHOLD.Decorum.Shabby'}}"></a> --}}
            <span title="{{localize 'HOUSEHOLD.Decorum.Decent'}}" class="editValue hh-decorum-step {{#when decorum 'eq' 3}} active{{/when}}" data-action="customEdit"
              data-object="actor" data-character-id="{{@root/id}}" data-path="system.decorum" data-value="3"
              data-dtype="Number" style="min-width: 38px;"></span>

            {{!-- <a class="editValue hud-decorum-step{{#when decorum 'eq' 3}} active{{/when}}"
              data-character-id="{{@root/id}}" data-path="system.decorum" data-value="3" data-dtype="Number"
              title="{{localize 'HOUSEHOLD.Decorum.Decent'}}"></a> --}}

            <span title="{{localize 'HOUSEHOLD.Decorum.Decent'}}" class="editValue hh-decorum-step {{#when decorum 'eq' 4}} active{{/when}}" data-action="customEdit"
              data-object="actor" data-character-id="{{@root/id}}" data-path="system.decorum" data-value="4"
              data-dtype="Number" style="min-width: 38px;"></span>
            {{!-- <a class="editValue hud-decorum-step{{#when decorum 'eq' 4}} active{{/when}}"
              data-character-id="{{@root/id}}" data-path="system.decorum" data-value="4" data-dtype="Number"
              title="{{localize 'HOUSEHOLD.Decorum.Elegant'}}"></a> --}}

            <span title="{{localize 'HOUSEHOLD.Decorum.Decent'}}" class="editValue hh-decorum-step {{#when decorum 'eq' 5}} active{{/when}}" data-action="customEdit"
              data-object="actor" data-character-id="{{@root/id}}" data-path="system.decorum" data-value="5"
              data-dtype="Number" style="min-width: 38px;"></span>
            {{!-- <a class="editValue hud-decorum-step{{#when decorum 'eq' 5}} active{{/when}}"
              data-character-id="{{@root/id}}" data-path="system.decorum" data-value="5" data-dtype="Number"
              title="{{localize 'HOUSEHOLD.Decorum.Pompous'}}"></a> --}}
          </div>
        </section>

        <section class="hud-popover-card">
          <div class="hud-popover-head">
            <h2>{{localize "HOUSEHOLD.TTT.long"}}</h2>
          </div>
          <div class="hud-ttt">
            {{#numLoop 5}}
            {{#when @root/ttt 'gteq' this}}
            <a class="editValue" data-character-id="{{@root/id}}" data-path="system.ttt"
              data-value="{{reduceBy this 1}}" data-dtype="Number"><img width="24" height="24"
                src="/systems/household/assets/sheet/ttt{{this}}-filled.svg"></a>
            {{else}}
            <a class="editValue" data-character-id="{{@root/id}}" data-path="system.ttt" data-value="{{this}}"
              data-dtype="Number"><img width="24" height="24" src="/systems/household/assets/sheet/ttt{{this}}.svg"></a>
            {{/when}}
            {{/numLoop}}
          </div>
        </section>
      </div>
    </div>
  </div>

  {{!-- ===================== Always-visible bar ===================== --}}
  <div class="character-info hud-bar">
    <div class="hud-portrait character" data-tooltip="{{name}}">
      <div id="frame" class="char-frame"></div>
      <div id="photo-mask">
        <img src="{{picture}}" alt="{{name}}" class="photo-subject">
      </div>
      <div id="glass-highlight"></div>
      <div id="grunge-texture-char" style="opacity: {{getOpacyDecorum decorum}};"></div>
      <span class="sheet-open hud-open" data-character-id="{{@root/id}}">{{localize "HOUSEHOLD.open_sheet"}}</span>
    </div>

    <div class="hud-identity">
      <span class="hud-name">{{name}}</span>
      {{#if profession}}<span class="hud-profession">{{profession}}</span>{{/if}}
      {{#if isCharacter}}
      <span class="hud-stress">
        <a class="hud-step editValue" data-path="system.stress.value" data-value="{{reduceBy stress.value 1}}"
          data-character-id="{{@root/id}}" data-dtype="Number" title="{{localize 'MESSAGES.Stress.Reduce'}}">&minus;</a>
        <span class="hud-stress-read{{#if stressCrucial}} crucial{{/if}}"
          {{#if stressCrucial}}data-tooltip="{{localize 'HOUSEHOLD.Stress.long'}}"{{/if}}>{{#if stressCrucial}}<i
            class="fa-solid fa-triangle-exclamation"></i> {{/if}}<b>{{stress.value}}</b><span>/ {{stress.max}} {{localize
            "HOUSEHOLD.Stress.long"}}</span></span>
        <a class="hud-step editValue" data-path="system.stress.value" data-value="{{increaseBy stress.value 1}}"
          data-character-id="{{@root/id}}" data-dtype="Number" title="{{localize 'MESSAGES.Stress.Increase'}}">+</a>
      </span>
      {{/if}}
    </div>

    <div class="hud-aces">
      <span class="hud-ace aces{{#if aces.heart}} active{{/if}}" data-path="system.aces.heart"
        data-value="{{aces.heart}}" data-character-id="{{@root/id}}"><i
          class="fa-household-heart{{#if aces.heart}}-full{{/if}}"></i></span>
      <span class="hud-ace aces{{#if aces.diamond}} active{{/if}}" data-path="system.aces.diamond"
        data-value="{{aces.diamond}}" data-character-id="{{@root/id}}"><i
          class="fa-household-diamond{{#if aces.diamond}}-full{{/if}}"></i></span>
      <span class="hud-ace aces{{#if aces.club}} active{{/if}}" data-path="system.aces.club" data-value="{{aces.club}}"
        data-character-id="{{@root/id}}"><i class="fa-household-club{{#if aces.club}}-full{{/if}}"></i></span>
      <span class="hud-ace aces{{#if aces.spade}} active{{/if}}" data-path="system.aces.spade"
        data-value="{{aces.spade}}" data-character-id="{{@root/id}}"><i
          class="fa-household-spade{{#if aces.spade}}-full{{/if}}"></i></span>
      <span class="hud-ace aces joker{{#if aces.joker}} active{{/if}}" data-path="system.aces.joker"
        data-value="{{aces.joker}}" data-character-id="{{@root/id}}"><i
          class="fa-household-joker{{#if aces.joker}}-full{{/if}}"></i></span>
    </div>

    <div class="hud-toolbar">
      <button
        class="hud-chip hud-chip-wide skills-toggle{{#when skillsToggle 'noteq' ''}}{{tabs.skillsToggle}}{{/when}}">{{localize
        "HOUSEHOLD.skills"}}</button>
      <button
        class="hud-chip hud-chip-wide actions-toggle{{#when actionsToggle 'noteq' ''}}{{tabs.actionsToggle}}{{/when}}">{{localize
        "HOUSEHOLD.actionsStats"}}</button>
    </div>
  </div>
</div>