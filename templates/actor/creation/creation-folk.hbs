{{!-- Step 1: Folk --}}
<section class="tab hh-creation-step {{tabs.folk.cssClass}}" data-tab="folk" data-group="primary">
  <header class="hh-creation-intro">
    <h2>{{localize "HOUSEHOLD.Creation.Step.Folk"}}</h2>
    <p>{{localize "HOUSEHOLD.Creation.FolkHint"}}</p>
  </header>

  <div class="hh-creation-options">
    {{#each folks as |folk|}}
    <button type="button" class="hh-creation-option{{#if folk.selected}} selected{{/if}}" data-action="selectFolk"
      data-uuid="{{folk.uuid}}" title="{{folk.name}}">
      <img src="{{folk.img}}" alt="" />
      <span class="hh-creation-option__name">{{folk.name}}</span>
    </button>
    {{else}}
    <p class="hh-creation-empty">{{localize "HOUSEHOLD.Creation.NoOptions"}}</p>
    {{/each}}
  </div>

  {{#if isSprite}}
  <div class="hh-creation-substep">
    <h3>{{localize "HOUSEHOLD.Creation.ElementTitle"}}</h3>
    <div class="hh-creation-options chips">
      {{#each spriteElements as |el|}}
      <button type="button" class="hh-creation-chip{{#if el.selected}} selected{{/if}}" data-action="selectElement"
        data-key="{{el.key}}">{{el.label}}</button>
      {{/each}}
    </div>
  </div>
  {{/if}}

  {{#if selectedFolk}}
  <div class="hh-creation-desc">{{{selectedFolk.system.description}}}</div>
  {{/if}}

  {{#if folkContract}}
  <div class="hh-creation-substep">
    <h3>{{localize "HOUSEHOLD.Contract.long"}}: {{folkContract.name}}</h3>
    <div class="hh-creation-contract">
      {{#if folkContract.system.description}}
      <div class="hh-creation-desc">{{{folkContract.system.description}}}</div>
      {{/if}}
      {{#if folkContract.system.concession.name}}
      <h4>{{localize "HOUSEHOLD.Concession.long"}}: {{folkContract.system.concession.name}}</h4>
      <div>{{{folkContract.system.concession.details}}}</div>
      {{/if}}
      {{#if folkContract.system.counterpart.name}}
      <h4>{{localize "HOUSEHOLD.Counterpart.long"}}: {{folkContract.system.counterpart.name}}</h4>
      <div>{{{folkContract.system.counterpart.details}}}</div>
      {{/if}}
    </div>
  </div>
  {{/if}}
</section>
