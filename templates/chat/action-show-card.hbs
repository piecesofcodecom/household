<div class="hh-chat-card hh-opponent-action">
  <header class="chat-card-header">
    <img class="chat-avatar" src="{{img}}" alt="" />
    <div class="chat-title">
      <strong>{{name}}</strong>
      <span>{{localize "HOUSEHOLD.RollActions.long"}}</span>
    </div>
    <span class="chat-badge wine">
      {{#numLoop 5}}
          {{#when ../threat 'gteq' this}}         
            <i class="hh-threat-pip fa-solid fa-spider"></i>
          {{else}}          
            <i class="hh-threat-pip fa-thin fa-spider" ></i>
          {{/when}}
          {{/numLoop}}
      {{!-- {{#when threat 'lteq' 1}}{{localize "HOUSEHOLD.BasicOpponent.long"}}{{else}}Threat {{threat}}{{/when}} --}}
    </span>
  </header>
  <div class="chat-card-body">
    <div class="action-row">
      <span class="roman">{{roman}}</span>
      <strong>{{description}}</strong>
    </div>
  </div>
</div>
