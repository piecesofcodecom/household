<div class="item-sheet">
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-action="editImage" data-field="img" title="{{item.name}}" />
    <div class="header-fields">
      <input class="item-name" name="name" type="text" value="{{item.name}}" placeholder="Name" data-dtype="String"/>
      <div class="grid grid-2col">
        <div class="ref-group">
          <label class="resource-label">{{localize "HOUSEHOLD.Contract.long"}}</label>
          {{#if refContract}}
          <div class="hh-fake-input header-link {{#if refContract.missing}}missing{{/if}}" title="{{refContract.name}}">
            <img src="{{refContract.img}}" alt="" />
            <span class="header-link__name">{{refContract.name}}</span>
            {{#if editable}}
            <a class="header-link__remove" data-action="removeRef" data-kind="contract" data-uuid="{{refContract.uuid}}"
              title="{{localize "HOUSEHOLD.RefRemove"}}"><i class="fas fa-times"></i></a>
            {{/if}}
          </div>
          {{else}}
          <div class="hh-fake-input ref-empty">{{localize "HOUSEHOLD.RefDropContract"}}</div>
          {{/if}}
      </div>
      <div style="display: flex; align-items: center;">
          <input class="resource-checkbox" id="{{item._id}}-free-reroll" type="checkbox" name="system.free_reroll"
            value="{{system.free_reroll}}" data-dtype="Boolean" {{#if system.free_reroll}}checked{{/if}} />
          <label for="{{item._id}}-free-reroll" class="resource-label">{{localize "HOUSEHOLD.FreeReRoll.long"}}</label>
        </div>
    </div>
    </div>
  </header>

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-action="tab" data-tab="description" data-group="primary">{{localize "HOUSEHOLD.SheetLabels.Description"}}</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">
    {{!-- Description Tab --}}
    <div class="tab {{tabs.description.cssClass}}" data-group="primary" data-tab="description">
       <div class="text-editor" style="height: 100%;">
      {{#if editable}}
        <prose-mirror
          name="system.description"
          button="true"
          editable="{{editable}}"
          toggled="false"
          value="{{system.description}}">
          {{{descriptionHTML}}}
        </prose-mirror>
      {{else}}
        {{{descriptionHTML}}}
      {{/if}}
      </div>
    </div>
  </section>
</div>

{{log system}}