<div class="item-sheet">
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-action="editImage" data-field="img" title="{{item.name}}" />
    <div class="header-fields">
      <input class="item-name" name="name" type="text" value="{{item.name}}" placeholder="Name" data-dtype="String" />
      <div class="grid grid-3col">
        <div class="ref-group">
          <label class="resource-label">{{localize "HOUSEHOLD.Profession.long"}}</label>
          <div class="ref-list ref-single">
            {{#if refProfession}}
            <div class="ref-chip {{#if refProfession.missing}}missing{{/if}}">
              <img src="{{refProfession.img}}" alt="" />
              <span class="ref-name">{{refProfession.name}}</span>
              {{#if editable}}
              <a class="ref-remove" data-action="removeRef" data-kind="profession"
                data-uuid="{{refProfession.uuid}}" title="{{localize "HOUSEHOLD.RefRemove"}}">
                <i class="fas fa-times"></i></a>
              {{/if}}
            </div>
            {{else}}
            <p class="ref-empty">{{localize "HOUSEHOLD.RefDropProfession"}}</p>
            {{/if}}
          </div>
        </div>
        <div style="    justify-self: center;
    text-align: center;">
    <label for="{{item._id}}-has-companion" class="resource-label">{{localize
            "HOUSEHOLD.HasCompanion.long"}}</label>
          <input class="resource-checkbox" id="{{item._id}}-has-companion" type="checkbox" name="system.has_companion"
            value="{{system.has_companion}}" data-dtype="Boolean" {{#if system.has_companion}}checked{{/if}} />
        </div>
        <div style="    justify-self: center;
    text-align: center;">
    <label for="{{item._id}}-free-reroll" class="resource-label">{{localize "HOUSEHOLD.FreeReRoll.long"}}</label>
          <input class="resource-checkbox" id="{{item._id}}-free-reroll" type="checkbox" name="system.free_reroll"
            value="{{system.free_reroll}}" data-dtype="Boolean" {{#if system.free_reroll}}checked{{/if}} />
          
        </div>
      </div>
  </header>

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-action="tab" data-tab="description" data-group="primary">{{localize
      "HOUSEHOLD.SheetLabels.Description"}}</a>
    <a class="item" data-action="tab" data-tab="configuration" data-group="primary">{{localize
      "HOUSEHOLD.SheetLabels.Configuration"}}</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">
    {{!-- Description Tab --}}
    <div class="tab {{tabs.description.cssClass}}" data-group="primary" data-tab="description">
      <div class="text-editor" style="height: 270px">
        {{#if editable}}
        <prose-mirror name="system.description" button="true" editable="{{editable}}" toggled="false"
          value="{{system.description}}">
          {{{descriptionHTML}}}
        </prose-mirror>
        {{else}}
        {{{descriptionHTML}}}
        {{/if}}
      </div>
    </div>
    {{!-- Attributes Tab --}}
    <div class="tab fields {{tabs.configuration.cssClass}}" data-group="primary" data-tab="configuration">
      <br />
      <div class="resource">
        <label class="resource-label">{{localize "HOUSEHOLD.Field.long"}}</label>
        {{!-- <input type="text" name="system.field" value="{{system.field}}" data-dtype="String" /> --}}
        <select name="system.field">
          <option value="" {{#ifEquals system.field "" }}selected{{/ifEquals}}>Select one Field</option>
          <option value="society" {{#ifEquals system.field "society" }}selected{{/ifEquals}}>Society</option>
          <option value="academia" {{#ifEquals system.field "academia" }}{{/ifEquals}}>Academia</option>
          <option value="war" {{#ifEquals system.field "war" }}selected{{/ifEquals}}>War</option>
          <option value="street" {{#ifEquals system.field "street" }}selected{{/ifEquals}}>Street</option>
        </select>
      </div>
      <br />
      <div class="ref-group">
        <label class="resource-label">{{localize "HOUSEHOLD.SheetLabels.Skills"}}</label>
        {{#if editable}}
        <div class="skill-picker">
          <select class="skill-to-add">
            {{#each availableSkills}}
            <option value="{{this.key}}">{{localize this.label}}</option>
            {{/each}}
          </select>
          <button type="button" class="skill-add-btn" data-action="addSkill">{{localize "HOUSEHOLD.RefAdd"}}</button>
        </div>
        {{/if}}
        <div class="ref-list">
          {{#each refSkills}}
          <div class="ref-chip">
            <span class="ref-name">{{localize this.label}}</span>
            {{#if ../editable}}
            <a class="ref-remove" data-action="removeSkill" data-key="{{this.key}}"
              title="{{localize "HOUSEHOLD.RefRemove"}}"><i class="fas fa-times"></i></a>
            {{/if}}
          </div>
          {{else}}
          <p class="ref-empty">{{localize "HOUSEHOLD.Placeholders.Skills"}}</p>
          {{/each}}
        </div>
      </div>
      <br />
      <div class="ref-group">
        <label class="resource-label">{{localize "HOUSEHOLD.Traits.long"}}</label>
        <div class="ref-list">
          {{#if system.has_companion}}
          <div class="ref-chip companion-note">
            <i class="fas fa-paw"></i>
            <span class="ref-name">{{localize "HOUSEHOLD.AmongCompanionTraits"}}</span>
          </div>
          {{/if}}
          {{#each refTraits}}
          <div class="ref-chip {{#if this.missing}}missing{{/if}}">
            <img src="{{this.img}}" alt="" />
            <span class="ref-name">{{this.name}}</span>
            {{#if ../editable}}
            <a class="ref-remove" data-action="removeRef" data-kind="trait" data-uuid="{{this.uuid}}"
              title="{{localize "HOUSEHOLD.RefRemove"}}"><i class="fas fa-times"></i></a>
            {{/if}}
          </div>
          {{else}}
          <p class="ref-empty">{{localize "HOUSEHOLD.RefDropTrait"}}</p>
          {{/each}}
        </div>
      </div>
    </div>

  </section>


  {{log system}}
</div>